# Installation Docker : l'URL PostgreSQL est construite dans docker-compose.yml.
# Renseigner un mot de passe aléatoire hexadécimal avant le démarrage.
POSTGRES_PASSWORD=

# Source officielle France Travail (inscription développeur nécessaire)
FRANCE_TRAVAIL_ENABLED=false
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_AUTH_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_API_URL=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FRANCE_TRAVAIL_KEYWORDS=développeur logiciel,développeur python,data analyst,data engineer,power bi,power platform

# Alertes officielles reçues par Gmail : LinkedIn, APEC, Indeed, HelloWork, Cadremploi
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=7
IMAP_MAX_MESSAGES=1000
MAX_JOB_AGE_HOURS=24

# Posts LinkedIn publics indexés par Brave Search (clé API personnelle requise)
PUBLIC_POSTS_ENABLED=false
BRAVE_SEARCH_API_KEY=
PUBLIC_POSTS_INTERVAL_HOURS=6

# Sources internationales facultatives, strictement filtrées sur la France
ENABLE_ARBEITNOW=false
ENABLE_REMOTIVE=false

# Envoi des alertes JobHunter par Gmail
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINATION=
SEARCH_INTERVAL_MINUTES=60
MIN_DAILY_SCORE=86
MIN_INSTANT_SCORE=86
EMAIL_ALL_NEW_ELIGIBLE=false
BASE_URL=http://localhost:8000
